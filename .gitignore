# ---- Data (never commit datasets) ----
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Generated demonstration fixtures and their rendered output. Reproducible
# from a seed (obsidianchain.demo.scenarios.DEMO_SEED), so there is nothing
# to preserve here.
data/demo/

# The operational console's application database and the datasets
# investigators upload into cases. This holds password hashes, session
# rows, case notes and evidence files - none of it belongs in a repo.
data/obsidianchain.sqlite3
data/obsidianchain.sqlite3-wal
data/obsidianchain.sqlite3-shm
data/uploads/
data/runs/

# The controlled synthetic world and the additive structural scan.
# Both are generated artifacts: reproducible from a seed and a
# command, and large enough that committing them would be noise.
data/synthetic_world/
data/synthetic_world_v2/
data/processed/tx_mixing.parquet
data/processed/tx_mixing.parquet.meta.json
data/reach_stress/

